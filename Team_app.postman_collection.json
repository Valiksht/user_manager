        {
          "name": "super login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Сохранить access_token в переменную\", function () {\r",
                  "    // Парсим JSON из тела ответа\r",
                  "    var jsonData = pm.response.json();\r",
                  "    \r",
                  "    // Сохраняем значение access_token в глобальную переменную\r",
                  "    pm.collectionVariables.set(\"Super_token\", jsonData.access_token);\r",
                  "    \r",
                  "    // Опционально: можно сохранить и token_type\r",
                  "    pm.collectionVariables.set(\"Super_type\", jsonData.token_type);\r",
                  "    \r",
                  "    console.log(\"Токен сохранен: \" + pm.collectionVariables.get(\"access_token\"));\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
